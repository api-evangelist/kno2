      },
      "item": [
        {
          "id": "77b3f912-139d-4f28-a8d2-db35caf2e8df",
          "name": "Issue an OAuth2 access token",
          "request": {
            "name": "Issue an OAuth2 access token",
            "description": {
              "content": "OAuth2 client-credentials token endpoint. Authenticate with HTTP Basic using base64(client_id:client_secret) and grant_type=client_credentials to receive a Bearer access token. A grant_type=refresh_token flow is also supported. CONFIRMED from ApiTestClient (AuthUri = api/token).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The subscription/tenant slug assigned to your Kno2 account.",
                  "type": "any",
                  "value": "{{subscription}}",
                  "key": "subscription"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>"
                }
              ]
            }
          },
          "response": [
            {
              "id": "72811c37-32e2-47da-bdc5-b550cc9ac10f",
              "name": "An access token.",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "The subscription/tenant slug assigned to your Kno2 account.",
                      "type": "any",
                      "value": "{{subscription}}",
                      "key": "subscription"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    {
                      "disabled": false,
                      "key": "grant_type",
                      "value": "client_credentials"
                    },
                    {
                      "disabled": false,
                      "key": "refresh_token",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 3600,\n  \"refresh_token\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
            {
              "id": "f0d5d184-2184-4fb2-98a7-55b6b3b5436e",
